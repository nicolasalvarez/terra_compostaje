---
import Logo from './Logo.astro';
import { useTranslations, rutas, type Locale } from '../i18n';
import { empresa, empresaB } from '../data/empresa';
import { conBase } from '../base';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = rutas.home[locale];
// Ver la nota en Header.astro: el prefijo nunca puede quedar vacio.
const base = home;
const anio = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="grid">
      <div>
        <Logo clase="pie-logo" />
        <p class="lema">{t.footer.lema}</p>
        <a class="bcorp" href={empresaB.perfil} target="_blank" rel="noopener">
          <img
            src={conBase("/marca/empresa-b-certificada.svg")}
            alt={t.footer.bcorpAlt}
            width="49"
            height="72"
            loading="lazy"
          />
        </a>
      </div>

      <div>
        <h3>{t.footer.servicios}</h3>
        <ul>
          {t.footer.itemsServicios.map((s) => (
            <li><a href={`${base}#soluciones`}>{s}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3>{t.footer.productos}</h3>
        <ul>
          <li><a href={`${base}#productos`}>{t.productos.nombres.compost}</a></li>
          <li><a href={`${base}#productos`}>{t.productos.nombres.paisajismo}</a></li>
          <li><a href={`${base}#productos`}>{t.productos.nombres.cultivo}</a></li>
          <li><a href={`${base}#productos`}>{t.productos.nombres.otros}</a></li>
        </ul>
      </div>

      <div>
        <h3>{t.footer.contacto}</h3>
        <ul>
          <li>
            <address>
              {empresa.direccion}<br />{empresa.ciudad}, {empresa.pais}
            </address>
          </li>
          <li><a href={`tel:${empresa.telefonoInternacional}`}>{empresa.telefonoVisible}</a></li>
          <li><a href={`mailto:${empresa.email}`}>{empresa.email}</a></li>
        </ul>

        <ul class="redes">
          <li>
            <a href={empresa.instagram} target="_blank" rel="noopener" aria-label={t.footer.instagram}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.4" fill="none" stroke="currentColor" stroke-width="1.8" />
                <circle cx="12" cy="12" r="4.15" fill="none" stroke="currentColor" stroke-width="1.8" />
                <circle cx="17.45" cy="6.55" r="1.25" fill="currentColor" />
              </svg>
            </a>
          </li>
          <li>
            <a href={empresa.linkedin} target="_blank" rel="noopener" aria-label={t.footer.linkedin}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3.02 9h3.93v12H3.02V9Zm6.44 0h3.77v1.64h.05c.53-.99 1.81-2.04 3.73-2.04 3.98 0 4.72 2.62 4.72 6.03V21h-3.93v-5.37c0-1.28-.02-2.93-1.79-2.93-1.79 0-2.06 1.4-2.06 2.84V21H9.46V9Z"
                />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="abajo">
      <span>© {anio} {empresa.nombre} · {empresa.razonSocial}. {t.footer.derechos}</span>
      <a href={rutas.privacidad[locale]}>{t.footer.privacidad}</a>
      <a href={rutas.terminos[locale]}>{t.footer.terminos}</a>
      <span>{t.footer.operador}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--papel);
    border-top: 1px solid var(--linea);
    padding-block: clamp(44px, 5vw, 64px);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
  }

  .grid :global(.pie-logo) {
    height: 44px;
    width: auto;
    margin-bottom: 16px;
  }

  /* Iconos de redes. Cuadrado de 40 px para que el area tactil sea comoda en
     mobile, aunque el dibujo mida 20. */
  .redes {
    display: flex;
    /* Hay que declararla: las otras listas del pie son columna y esta la heredaba. */
    flex-direction: row;
    gap: 4px;
    margin-top: 14px;
    padding: 0;
    list-style: none;
  }

  .redes a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: -10px;
    color: var(--tinta-60);
    border-radius: 50%;
  }

  .redes a:hover,
  .redes a:focus-visible {
    color: var(--naranja-texto);
  }

  .redes svg {
    width: 20px;
    height: 20px;
  }

  /* Sello oficial de Empresa B. El archivo es el de B Lab, sin recolorear. */
  .bcorp {
    display: inline-block;
    margin-top: 18px;
  }

  .bcorp img {
    width: 49px; /* 72 px de alto: el minimo de B Lab para web */
    height: auto;
  }

  .lema {
    max-width: 32ch;
    font-size: 14px;
    color: var(--tinta-60);
  }

  h3 {
    margin-bottom: 14px;
    font-family: var(--texto);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-60);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  address {
    font-style: normal;
  }

  ul a:hover {
    color: var(--naranja-texto);
  }

  .abajo {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid var(--linea);
    font-size: 12.5px;
    color: var(--tinta-60);
  }

  .abajo a:hover {
    color: var(--naranja-texto);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 460px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
