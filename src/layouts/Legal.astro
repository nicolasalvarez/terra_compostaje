---
import Base from './Base.astro';
import type { Locale, Pagina } from '../i18n';

interface Props {
  locale: Locale;
  pagina: Pagina;
  titulo: string;
  descripcion: string;
  actualizado: string;
  etiquetaActualizado: string;
}
const { locale, pagina, titulo, descripcion, actualizado, etiquetaActualizado } = Astro.props;
---

<Base locale={locale} pagina={pagina} titulo={`${titulo} · Terra Compostaje`} descripcion={descripcion}>
  <article class="legal">
    <div class="wrap">
      <header>
        <h1>{titulo}</h1>
        <p class="fecha">{etiquetaActualizado} {actualizado}</p>
      </header>
      <div class="cuerpo">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: clamp(48px, 6vw, 84px);
  }

  header {
    max-width: 62ch;
    padding-bottom: 28px;
    margin-bottom: 40px;
    border-bottom: 2px solid var(--tinta);
  }

  h1 {
    font-size: clamp(32px, 4.4vw, 50px);
  }

  .fecha {
    margin-top: 14px;
    font-size: 13px;
    color: var(--tinta-60);
  }

  .cuerpo {
    max-width: 68ch;
  }

  .cuerpo :global(h2) {
    margin-top: 44px;
    margin-bottom: 14px;
    font-size: clamp(20px, 2.2vw, 25px);
  }

  .cuerpo :global(h3) {
    margin-top: 28px;
    margin-bottom: 10px;
    font-size: 17px;
  }

  .cuerpo :global(p),
  .cuerpo :global(li) {
    font-size: 15.5px;
    line-height: 1.75;
    color: #414a63;
  }

  .cuerpo :global(p + p) {
    margin-top: 14px;
  }

  .cuerpo :global(ul) {
    margin: 14px 0 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cuerpo :global(a) {
    color: var(--naranja-texto);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cuerpo :global(strong) {
    color: var(--tinta);
    font-weight: 600;
  }

  .cuerpo :global(.destacado) {
    margin-top: 22px;
    padding: 20px 24px;
    border-left: 4px solid var(--naranja);
    background: var(--papel);
    border-radius: 0 10px 10px 0;
  }

  .cuerpo :global(.destacado p) {
    font-size: 14.5px;
  }
</style>
